{
  "name": "front-range-food-source",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:emulator": "node scripts/test-env.mjs ./node_modules/.bin/firebase emulators:exec --project demo-food-source --only auth,firestore \"node --import tsx --test --test-concurrency=1 tests/firestore.test.ts\"",
    "test:browser": "node scripts/test-env.mjs ./node_modules/.bin/playwright test",
    "build:test": "node scripts/test-env.mjs ./node_modules/.bin/next build",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@grpc/grpc-js": ">=1.13.6 <2"
  }
}
