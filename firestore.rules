rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if false;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packingStatus'])
        && request.resource.data.packingStatus.keys().hasOnly(['dryGoods', 'freshGoods'])
        && request.resource.data.packingStatus.dryGoods in ['PENDING', 'PACKED']
        && request.resource.data.packingStatus.freshGoods in ['PENDING', 'PACKED'];
    }
    match /batches/{id} { allow read: if admin(); allow write: if false; }
    match /settings/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
