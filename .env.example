NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only: service account JSON, or configure Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Phase Two staff workspace. Leave disabled for the current check-in pilot.
FULFILLMENT_PHASE_TWO_ENABLED=false
# Local emulator use only; never set these in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_USE_EMULATORS=true

# Hosted pickup pilot: enable only after staging/cutover checks.
PICKUP_HOSTED_ENABLED=false
# Server-only source workbook ID; share it with the integration service account.
PICKUP_SOURCE_SPREADSHEET_ID=
# Optional separate Sheets service account JSON; otherwise reuses FIREBASE_SERVICE_ACCOUNT_KEY.
PICKUP_GOOGLE_SERVICE_ACCOUNT_KEY=
# PrintNode printer ID and measured label stock. Example only.
PICKUP_PRINTER_CONFIG='{"id":12345,"dpi":203,"widthIn":3,"heightIn":2}'
PRINTNODE_API_KEY=
# Authenticate the scheduled /api/pickup/worker endpoint. Use a strong random secret.
CRON_SECRET=
